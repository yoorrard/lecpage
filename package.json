{
  "name": "lecpage",
  "private": true,
  "version": "1.0.0",
  "description": "연수 교재와 연수 정보로 맞춤 연수 사이트를 만드는 Agent Skill과 웹앱",
  "license": "Apache-2.0 AND MIT-0",
  "type": "module",
  "engines": { "node": ">=22" },
  "bin": { "lecpage": "skills/lecpage/scripts/lecpage.mjs" },
  "files": [
    "skills/lecpage/",
    "!skills/lecpage/engine/test/",
    "!skills/lecpage/evals/",
    "!**/__pycache__/",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md",
    "TRADEMARKS.md"
  ],
  "scripts": {
    "test": "node --test \"skills/lecpage/engine/test/*.test.mjs\" \"scripts/ai-catalog/test/*.test.mjs\"",
    "ai-catalog": "node scripts/ai-catalog/refresh.mjs",
    "examples": "node scripts/check-references.mjs",
    "app:dev": "npm --prefix app run dev",
    "app:build": "npm --prefix app run build",
    "verify": "bash scripts/verify.sh",
    "verify:full": "bash scripts/verify.sh --e2e --hosting"
  },
  "devDependencies": {
    "wrangler": "4.158.0"
  }
}
