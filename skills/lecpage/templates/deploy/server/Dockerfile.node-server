# lecpage node-server 컨테이너 이미지 (의존성 없음, Node 22.5+ 내장 node:sqlite 사용)
# backends/node-server/ 에 Dockerfile 이 없을 때 이 파일을 그 폴더에 "Dockerfile" 이름으로 복사해 씁니다.
# (Fly.io·Render·Railway·Lightsail 컨테이너처럼 이미지를 빌드해야 하는 곳용.
#  docker-compose.yml 은 이미지 빌드 없이 공식 node 이미지에 폴더를 연결하므로 이 파일이 필요 없습니다.)
#
#   docker build -t lec-live .
#   docker run -p 8787:8787 -v "$PWD/data:/data" lec-live
#   → 처음 실행 로그에 관리자 키가 한 번 나옵니다(LEC_ADMIN_KEY_HASH 를 주면 생략).

FROM node:24-alpine
WORKDIR /app
COPY . .
ENV PORT=8787 \
    LEC_DATA=/data \
    LEC_HOST=0.0.0.0 \
    TZ=Asia/Seoul
# 클라우드 볼륨은 root 소유로 붙는 경우가 많아 기본 사용자(root)로 실행합니다.
RUN mkdir -p /data
VOLUME ["/data"]
EXPOSE 8787
CMD ["node", "--disable-warning=ExperimentalWarning", "server.mjs"]
