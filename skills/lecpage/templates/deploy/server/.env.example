# docker-compose.yml 옆에 .env 로 복사해서 고칩니다.  cp .env.example .env
# 고친 .env 는 공개 저장소에 올리지 마세요. 이 파일(.env.example)에는 비밀값이 없습니다.
#
# 데이터 폴더: ./data (compose가 컨테이너의 /data 에 연결. 연수 뒤 지우면 데이터 삭제 완료)
# 관리자 키:   LEC_ADMIN_KEY_HASH 를 비워 두면 첫 실행 때 키를 만들어 ./data/admin-key.txt(권한 0600)에 둡니다.
#              확인: docker compose exec live cat /data/admin-key.txt  (로그에는 남기지 않음)

# 교실 LAN·NAS: ":80"   /   인터넷 공개 서버: "lec.school.kr" (HTTPS 자동)
LEC_SITE_ADDRESS=:80

# 80/443을 이미 쓰는 기기(NAS 등)면 다른 번호로. 예) 8080, 8443
LEC_HTTP_PORT=80
LEC_HTTPS_PORT=443

# 관리자 키의 SHA-256. 만들기: node node-server/server.mjs --hash '내관리자키'
# 비워 두면 위 설명대로 ./data/admin-key.txt 에 새 키를 만듭니다.
LEC_ADMIN_KEY_HASH=

# 다른 주소의 사이트(예: https://아이디.github.io)가 이 서버를 부를 때만. 쉼표로 구분. 비우면 모두 허용.
LEC_ORIGINS=

# 게시판 파일 한도(MB)와 데이터 자동 삭제 기간(일)
LEC_MAX_UPLOAD_MB=20
LEC_RETENTION_DAYS=30

# 도메인으로 HTTPS 운영 시 오래된 Safari 대비로 넣어 두면 좋음. 예) wss://lec.school.kr
LEC_CSP_CONNECT_EXTRA=
