{
  "name": "lecpage-sites",
  "private": true,
  "version": "1.0.0",
  "description": "lecpage 바로 공개 호스트(선택). Cloudflare Worker + Durable Objects(SQLite)",
  "license": "Apache-2.0",
  "type": "module",
  "engines": { "node": ">=22.15" },
  "scripts": {
    "gen": "node scripts/gen-runtime.mjs",
    "runtime:keep": "node scripts/gen-runtime.mjs --keep",
    "dev": "wrangler dev",
    "pretest": "node scripts/gen-runtime.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "predeploy": "node scripts/gen-runtime.mjs",
    "deploy": "wrangler deploy",
    "check": "wrangler deploy --dry-run --outdir .wrangler/dry-run"
  },
  "devDependencies": {
    "wrangler": "4.158.0"
  }
}
