{
  "name": "lecpage-sites",
  "private": true,
  "version": "1.0.0",
  "description": "lecpage 바로 배포 서버(선택). Cloudflare Worker + Durable Objects(SQLite)",
  "license": "Apache-2.0",
  "type": "module",
  "engines": { "node": ">=22.15" },
  "scripts": {
    "gen": "node scripts/gen-runtime.mjs",
    "runtime:keep": "node scripts/gen-runtime.mjs --keep",
    "dev": "wrangler dev",
    "pretest": "node scripts/gen-runtime.mjs && node scripts/gen-admin.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "setup": "node scripts/setup.mjs",
    "predeploy": "node scripts/gen-runtime.mjs",
    "deploy": "wrangler deploy",
    "deploy:admin": "wrangler deploy -c wrangler.admin.jsonc",
    "check": "wrangler deploy --dry-run --outdir .wrangler/dry-run && wrangler deploy -c wrangler.admin.jsonc --dry-run --outdir .wrangler/dry-run-admin"
  },
  "devDependencies": {
    "wrangler": "4.158.0"
  }
}
