// lecpage 바로 공개 호스트(선택). 운영자가 직접 배포할 때만 켜집니다 → README.md
// 앱(lecpage)과 반드시 다른 주소(출처)에 두세요. 앱은 사용자의 AI 키를 자기 출처에 보관합니다.
// 무료 요금제로도 돕니다: Worker + Durable Objects(SQLite 저장). R2·KV를 쓰지 않아 카드 등록이 필요 없습니다.
// 여러 강사에게 열어 둘 서버는 Workers Paid(월 $5) + PLAN "paid"를 권합니다(하루 한도로 사이트가 멈추지 않음) → README §4
{
  "name": "lecpage-sites",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,

  // 안내·신고 화면(public/)은 정적 자산이라 Worker 요청 수에 들지 않습니다. 그 밖의 주소(/api, /s)는 src/index.js로 갑니다.
  "assets": { "directory": "./public" },

  // 배포·개발 서버를 띄우기 전에 엔진 런타임 목록(src/runtime-allow.js)을 다시 만듭니다.
  "build": { "command": "node scripts/gen-runtime.mjs" },

  "durable_objects": {
    "bindings": [
      { "name": "SITE", "class_name": "Site" }, // 사이트 하나마다 하나: 파일
      { "name": "GATE", "class_name": "Gate" }, // 하나뿐: 횟수 제한·저장량·신고
      { "name": "ROOM", "class_name": "Room" }, // 연수 코드마다 하나: 실시간 방(질문·보드·투표)
      { "name": "GUARD", "class_name": "Guard" } // IP마다 하나: 틀린 강사 키 횟수
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Site", "Gate", "Room", "Guard"] }],

  // 보드 파일을 R2에 두려면(선택, 카드 등록 필요) 버킷을 만들고 아래 주석을 푸세요. 없으면 방의 SQLite에 담습니다.
  // "r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "lecpage-sites-uploads" }],

  // 여기 적은 값은 배포할 때마다 그대로 들어갑니다. 비밀 값(ADMIN_KEY, REPORT_WEBHOOK)은 `npx wrangler secret put`으로 넣으세요.
  "vars": {
    // 바로 공개를 부를 수 있는 앱 주소(쉼표로 구분). 앱을 내 도메인에 올렸으면 그 주소를 더하세요.
    "ALLOWED_ORIGINS": "https://yoorrard.github.io,http://localhost:5173,http://localhost:4173"
    // 요금제: PLAN "free"(기본. 무료 요금제 안에서만, 하루 예산의 60%를 쓰면 새 사이트를 받지 않음) | "paid"(Workers Paid로 올린 뒤. 하루 한도 없음)
    // DAILY_REQUEST_BUDGET 100000(paid는 0) · KEEP_ALIVE "on"(방문이 있으면 공개 기간을 다시 채움) · MAX_SITE_DAYS 365
    // 바꿀 수 있는 한도(기본값): MAX_BYTES 41943040 · MAX_FILE_BYTES 20971520 · MAX_FILES 600 · SITE_DAYS 30
    // SITES_PER_HOUR 6 · SITES_PER_DAY 20 · DAILY_SITE_CAP 30 · MAX_TOTAL_BYTES 4294967296 · DEPLOYS_PER_HOUR 30
    // REPORTS_PER_HOUR 5 · DAILY_REPORT_CAP 200 · REPORT_KEEP 500 · REPORT_DAYS 90 · PUBLIC_ORIGIN(내 도메인을 붙였을 때 주소 고정)
    // 실시간 방: LIVE "on"(끄려면 "off") · LIVE_UPLOADS "on" · LIVE_MAX_UPLOAD_MB 10 · LIVE_ROOM_MB 200
    // LIVE_MAX_PARTICIPANTS 300 · LIVE_SOCKETS_PER_IP 500 · DAILY_ROOM_CAP 30
    // ALLOW_SUPABASE_SDK "1"(Supabase 실시간을 쓰는 사이트를 받을 때만. README의 '실시간 연결' 참고)
  }
}
